{
  "cleanupPeriodDays": 3650,
  "syncClaudeAiPlugins": false,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUPPRESS_SESSION_ATTRIBUTION": "1",
    "DISABLE_AUTOUPDATER": "1",
    "LLM": "1",
    "NO_COLOR": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Edit(**)",
      "Bash(actionlint:*)",
      "Bash(alias:*)",
      "Bash(bash:*)",
      "Bash(cat:*)",
      "Bash(command:*)",
      "Bash(convert:*)",
      "Bash(cp:*)",
      "Bash(echo:*)",
      "Bash(env:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(grep:*)",
      "Bash(gs:*)",
      "Bash(head:*)",
      "Bash(exiftool:*)",
      "Bash(ls:*)",
      "Bash(magick:*)",
      "Bash(md5:*)",
      "Bash(mdfind:*)",
      "Bash(mdls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(pdftotext:*)",
      "Bash(qpdf:*)",
      "Bash(pip:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(rg:*)",
      "Bash(ruff:*)",
      "Bash(sort:*)",
      "Bash(sphinx-build:*)",
      "Bash(tail:*)",
      "Bash(typos:*)",
      "Bash(unzip:*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Bash(xxd:*)",
      "Read(//tmp/**)",
      "WebSearch",
      "WebFetch(domain:*.blob.core.windows.net)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:en.wikipedia.org)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:kdeldycke.github.io)",
      "WebFetch(domain:myst-parser.readthedocs.io)",
      "WebFetch(domain:news.ycombinator.com)",
      "WebFetch(domain:nuitka.net)",
      "WebFetch(domain:packaging.python.org)",
      "WebFetch(domain:peps.python.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(cd *)"
    ],
    "ask": [
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr review *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "built-in-browser": "off",
    "chrome-browser": "off",
    "computer-use": "off"
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/kde/code/dotfiles/dotfiles/.claude/hooks/wrapup-session-nudge.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/kde/code/dotfiles/dotfiles/.claude/hooks/session-title.py sessionstart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/kde/code/dotfiles/dotfiles/.claude/hooks/session-title.py hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/kde/code/dotfiles/dotfiles/.claude/hooks/session-title.py userpromptsubmit"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/kde/code/dotfiles/dotfiles/.claude/statusline.py",
    "padding": 0
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "kdeldycke": {
      "source": {
        "source": "github",
        "repo": "kdeldycke/repomatic"
      }
    }
  },
  "outputStyle": "Terse",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "*.blob.core.windows.net"
      ],
      "allowUnixSockets": [
        "~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "/private/tmp",
        "~/.cache/gh",
        "~/.cache/nvim",
        "~/.cache/uv",
        "~/.local/share/nvim",
        "~/.local/state/nvim",
        "~/code",
        "~/Library/Application Support/uv",
        "~/Library/Caches/mdedup",
        "~/Library/Caches/repomatic",
        "~/Library/Logs/pipx"
      ],
      "denyWrite": [
        "~/code/dotfiles/dotfiles"
      ],
      "denyRead": [
        "~/.ssh"
      ],
      "allowRead": [
        "~/.ssh/allowed_signers",
        "~/.ssh/id_ed25519.pub",
        "~/.ssh/ssh-keygen-secretive",
        "~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
      ]
    },
    "enableWeakerNetworkIsolation": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
