# Compare with defaults from: https://man.openbsd.org/ssh_config

# To generate keys:
#   $ ssh-keygen -t ed25519 -o -a 100 -C ''

# Test Github.com connection with:
#   $ ssh -vT git@github.com
#   OpenSSH_9.9p1, OpenSSL 3.4.0 22 Oct 2024
#   (...)
#   Hi kdeldycke! You've successfully authenticated, but GitHub does not provide shell access.

Compression yes

# Allow connection sharing
ControlMaster auto
ControlPath /tmp/ssh_%h_%p_%r

# Keep all connexions open for 3 hours
# Depending of your version of OpenSSH this might not work in combination with the ForwardAgent
#     option, and you'll get errors like "Bad packet length 1397966893".
#     For details, see: https://www.gossamer-threads.com/lists/openssh/dev/51499
ControlPersist 3h

# Keep TCP connection alive for a maximum of one hour (60 minutes) by sending a packet every 60 seconds.
ServerAliveInterval 60
ServerAliveCountMax 60

# Always force canonicalization of host names.
CanonicalizeHostname yes
CanonicalizeMaxDots 0

# Always show keys in ASCII art
VisualHostKey yes

# Beware of SSH configuration algorithm: it only applies options from
# subsequent matching sections if and only if that option has not been defined by
# previous sections. Which means it will always use the FIRST value given for
# each option. This is perfectly detailed in:
# https://www.digitalocean.com/community/tutorials/how-to-configure-custom-connection-options-for-your-ssh-client#interpretation-algorithm

# Local UTM guests used to develop and test meta-package-manager. Each takes
# its address from DHCP, so the address moves. The `utm-host.py` script beside
# this file resolves a guest by the MAC address that UTM pins in its own
# config, which is why no address appears here. List them, with the address
# each one holds right now:
#   $ ~/.ssh/utm-host.py list
# Every option this section sets is one the block above leaves alone, because
# the first value wins and the block above is read first.

Host alpine fedora freebsd
    User root

Host arch debian opensuse solus ubuntu
    User user

# illumos blocks root over SSH: root is a role there, and the stock
# `sshd_config` sets `PermitRootLogin no`. The `claude` account carries the
# `Primary Administrator` profile, so `pfexec` gives passwordless root once in.
# Its key is separate from the one the other guests take.
Host illumos
    User claude
    IdentityFile /Users/kde/code/.claude-vm-keys/illumos_ed25519

Host windows
    User kev

Host alpine arch debian fedora freebsd illumos opensuse solus ubuntu windows
    ProxyCommand ~/.ssh/utm-host.py connect %h %p
    # Offer the on-disk key alone. The Secure Enclave key that the global
    # IdentityAgent serves asks for approval on each login, which is friction
    # with no value on a throwaway guest.
    IdentityAgent none
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    # These guests get rebuilt often, so a new or changed host key is normal
    # here and is not evidence of an attack. Keep their keys in a file of their
    # own, so a rebuild never touches the record of a real host.
    UserKnownHostsFile ~/.ssh/known_hosts_utm
    StrictHostKeyChecking no

Host 192.168.1.82 truenas.local
    User kev
    IdentityFile ~/.ssh/id_ed25519
    PubkeyAuthentication yes

# Local Ubuntu VM for mpm testing.
Host 192.168.64.11
    User user
    IdentityFile ~/.ssh/id_ed25519
    PasswordAuthentication yes

# Alpine Linux GitLab (aports pushes) authenticate with the on-disk
# id_ed25519 key, registered there with the "Authentication" usage type.
# The Secretive Secure Enclave key is registered as "Signing" only, so the
# global IdentityAgent below would offer only that key and GitLab would
# reject the push as "Anonymous". Force the auth key and bypass the agent.
Host gitlab.alpinelinux.org
    IdentityAgent none
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Prioritize post-quantum, then elliptic curve cryptography:
# https://stribika.github.io/2015/01/04/secure-secure-shell.html
# https://www.ssh-audit.com/hardening_guides.html
Host *
    # https://github.com/maxgoedjen/secretive/issues/194
    IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
    PasswordAuthentication no
    PubkeyAuthentication yes
    # List with: ssh -Q kex
    KexAlgorithms mlkem768x25519-sha256,curve25519-sha256,curve25519-sha256@libssh.org
    # List ciphers with: ssh -Q cipher
    Ciphers chacha20-poly1305@openssh.com
    # List with: ssh -Q mac
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
    # List with: ssh -Q key
    HostKeyAlgorithms sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,ssh-ed25519
    # List with: ssh -Q CASignatureAlgorithms
    CASignatureAlgorithms sk-ssh-ed25519@openssh.com,ssh-ed25519
    # List with: ssh -Q HostbasedAcceptedAlgorithms
    HostbasedAcceptedAlgorithms sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,ssh-ed25519
    # List with: ssh -Q PubkeyAcceptedAlgorithms
    # ecdsa-sha2-nistp256 required by Secretive (Secure Enclave only supports P-256).
    # https://github.com/maxgoedjen/secretive/issues/407
    PubkeyAcceptedAlgorithms sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,ssh-ed25519,ecdsa-sha2-nistp256